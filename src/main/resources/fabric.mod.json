{
  "schemaVersion": 1,
  "id": "player-portals-justfatlard",
  "version": "${version}",
  "name": "Player Portals",
  "description": "A striker that lights two obsidian frames and ties them to each other instead of to the map",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/player-portals"
  },
  "license": "MIT",
  "icon": "assets/player-portals-justfatlard/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "justfatlard.player_portals.Main"
    ]
  },
  "mixins": [
    "player-portals-justfatlard.mixins.json",
    "player-portals-justfatlard.festering.mixins.json"
  ],
  "suggests": {
    "festeringportal": "*"
  },
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=1.3.9"
  }
}
